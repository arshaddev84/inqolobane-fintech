<Window
    x:Class="Inqolobane.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Inqolobane Operations">
    <Grid RequestedTheme="Dark" Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#171D19" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" Padding="16,24,14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,30">
                    <Border Width="30" Height="30" BorderBrush="#70865A" BorderThickness="1">
                        <TextBlock Text="I" Foreground="{StaticResource AccentBrush}" FontFamily="Georgia" FontSize="20" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="inqolobane" Foreground="{StaticResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="OPERATIONS" Foreground="#738077" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100" Margin="10,0,0,10" />
                <StackPanel Grid.Row="2" Spacing="5">
                    <Button x:Name="CasesNavButton" Click="CasesNavButton_Click" HorizontalContentAlignment="Left" Background="#283323" Foreground="{StaticResource AccentBrush}" BorderBrush="#3C4A35" BorderThickness="1" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE8A5;" FontSize="16" /><TextBlock Text="Case queue" /><TextBlock x:Name="CaseNavCount" Text="0" Margin="22,0,0,0" Foreground="#9BAA91" /></StackPanel>
                    </Button>
                    <Button x:Name="ProfilesNavButton" Click="ProfilesNavButton_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#AAB5AC" BorderBrush="Transparent" BorderThickness="1" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE8A9;" FontSize="16" /><TextBlock Text="Profile review" /><TextBlock x:Name="ProfileNavCount" Text="0" Margin="3,0,0,0" Foreground="#9BAA91" /></StackPanel>
                    </Button>
                    <Button x:Name="DocumentsNavButton" Click="DocumentsNavButton_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#AAB5AC" BorderBrush="Transparent" BorderThickness="1" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE8A5;" FontSize="16" /><TextBlock Text="Source library" /><TextBlock x:Name="DocumentNavCount" Text="0" Margin="8,0,0,0" Foreground="#9BAA91" /></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="7" Margin="8,0,0,0">
                    <TextBlock Text="DATA SOURCE" Foreground="#738077" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#D5AC62" VerticalAlignment="Center" />
                        <TextBlock Text="FastAPI · PostgreSQL" Foreground="#C4CEC5" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="Read-only review environment" Foreground="#738077" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Padding="32,25,32,18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="BreadcrumbText" Text="CUSTOMER OPERATIONS  /  CASES" Foreground="#9AA69C" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" />
                    <TextBlock x:Name="PageTitle" Text="Case queue" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Georgia" FontSize="34" Margin="0,8,0,2" />
                    <TextBlock x:Name="PageSubtitle" Text="Review incoming complaints and supporting details." Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Click="RefreshButton_Click" VerticalAlignment="Top" Background="#202822" Foreground="#DDE5DD" BorderBrush="{StaticResource DividerBrush}" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" Foreground="{StaticResource AccentBrush}" FontSize="13" /><TextBlock Text="Refresh" /></StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,23,0,20" ColumnSpacing="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#29322C" BorderThickness="1" Padding="15,12">
                    <StackPanel><TextBlock Text="CASES" Foreground="#819086" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" /><TextBlock x:Name="CaseMetric" Text="—" Foreground="{StaticResource PrimaryTextBrush}" FontSize="23" Margin="0,5,0,0" /><TextBlock Text="matching records" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#29322C" BorderThickness="1,1,0,1" Padding="15,12">
                    <StackPanel><TextBlock Text="IN REVIEW" Foreground="#819086" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" /><TextBlock x:Name="ProfileMetric" Text="—" Foreground="{StaticResource PrimaryTextBrush}" FontSize="23" Margin="0,5,0,0" /><TextBlock Text="profile exceptions" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#29322C" BorderThickness="1,1,0,1" Padding="15,12">
                    <StackPanel><TextBlock Text="DOCUMENTS" Foreground="#819086" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" /><TextBlock x:Name="DocumentMetric" Text="—" Foreground="{StaticResource PrimaryTextBrush}" FontSize="23" Margin="0,5,0,0" /><TextBlock Text="available sources" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{StaticResource PanelBrush}" BorderBrush="#29322C" BorderThickness="1" Padding="15,12">
                    <StackPanel><TextBlock Text="DATABASE" Foreground="#819086" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" /><TextBlock x:Name="DatabaseMetric" Text="Checking" Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,9,0,3" /><TextBlock Text="readiness endpoint" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" /></StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,13" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="190" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Search cases, customers, or references" KeyDown="SearchBox_KeyDown" VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="SearchButton_Click" Content="Search" Background="#293523" Foreground="{StaticResource AccentBrush}" BorderBrush="#3D4B34" Padding="14,7" />
                <ComboBox x:Name="CaseStatusFilter" Grid.Column="2" Header="Case status" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" Visibility="Visible">
                    <ComboBoxItem Content="All statuses" Tag="" /><ComboBoxItem Content="Open" Tag="OPEN" /><ComboBoxItem Content="Triaged" Tag="TRIAGED" /><ComboBoxItem Content="Investigating" Tag="INVESTIGATING" /><ComboBoxItem Content="Awaiting customer" Tag="AWAITING_CUSTOMER" /><ComboBoxItem Content="Escalated" Tag="ESCALATED" /><ComboBoxItem Content="Resolved" Tag="RESOLVED" /><ComboBoxItem Content="Closed" Tag="CLOSED" />
                </ComboBox>
                <ComboBox x:Name="ProfileStatusFilter" Grid.Column="3" Header="Sync status" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" Visibility="Collapsed">
                    <ComboBoxItem Content="All statuses" Tag="" /><ComboBoxItem Content="Current" Tag="CURRENT" /><ComboBoxItem Content="Stale" Tag="STALE" /><ComboBoxItem Content="Failed" Tag="FAILED" /><ComboBoxItem Content="Pending review" Tag="PENDING_REVIEW" />
                </ComboBox>
                <TextBlock x:Name="ApiStatusText" Grid.Column="4" Text="Connecting to API" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <Grid Grid.Row="3">
                <Grid x:Name="CasesView" Visibility="Visible">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1.55*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#29322C" BorderThickness="1,1,0,1">
                        <Grid RowDefinitions="Auto,*">
                            <Border Padding="14,11" BorderBrush="#303B33" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="COMPLAINTS" Foreground="#819086" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" /><TextBlock x:Name="CaseListCount" Grid.Column="1" Text="0 results" Foreground="#819086" FontSize="11" HorizontalAlignment="Right" /></Grid></Border>
                            <ListView x:Name="CaseList" Grid.Row="1" ContainerContentChanging="ListView_ContainerContentChanging" SelectionChanged="CaseList_SelectionChanged" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,11" BorderBrush="#29322C" BorderThickness="0,0,0,1">
                                        <Grid RowSpacing="6">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ComplaintRef}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Priority}" Foreground="#D9B875" FontSize="10" /></Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding CustomerSummary}" Foreground="#D0D8D1" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Category}" Foreground="#929E94" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding OpenedDisplay}" Foreground="#819086" FontSize="10" /></Grid>
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Column="1" Background="#1B211D" BorderBrush="#29322C" BorderThickness="1" Padding="24,21">
                        <StackPanel Spacing="14">
                            <TextBlock Text="CASE DETAIL" Foreground="#819086" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel><TextBlock x:Name="CaseCategoryText" Text="Select a case" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Georgia" FontSize="24" TextWrapping="Wrap" /><TextBlock x:Name="CaseReferenceText" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel><Border Grid.Column="1" Background="#283323" Padding="8,5" VerticalAlignment="Top"><TextBlock x:Name="CaseStatusText" Foreground="{StaticResource AccentBrush}" FontSize="11" /></Border></Grid>
                            <TextBlock x:Name="CaseSummaryText" Text="Choose a case from the queue to inspect its details." Foreground="#C4CEC5" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
                            <Border Height="1" Background="#303B33" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="18">
                                <StackPanel><TextBlock Text="CUSTOMER REF" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="CustomerRefText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="ACCOUNT REF" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="AccountRefText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                                <StackPanel Grid.Row="1"><TextBlock Text="PRODUCT" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="ProductText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="SUBCATEGORY" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="SubcategoryText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                                <StackPanel Grid.Row="2"><TextBlock Text="ALLEGATION" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="AllegationText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="OPENED" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="OpenedText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                                <StackPanel Grid.Row="3"><TextBlock Text="TARGET RESOLUTION" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="TargetDateText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1"><TextBlock Text="PRIORITY" Style="{StaticResource FieldLabelStyle}" /><TextBlock x:Name="PriorityText" Style="{StaticResource FieldValueStyle}" /></StackPanel>
                            </Grid>
                            <Border Height="1" Background="#303B33" Margin="0,3,0,0" />
                            <TextBlock Text="Customer-reported information · Human review required" Foreground="#819086" FontSize="11" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ProfilesView" Visibility="Collapsed">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#29322C" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Padding="14,11" BorderBrush="#303B33" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="1.1*,1.1*,2*,1.3*,1.1*">
                            <TextBlock Text="CUSTOMER" Foreground="#819086" FontSize="10" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="FIELD" Foreground="#819086" FontSize="10" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="OBSERVED VALUE" Foreground="#819086" FontSize="10" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="SOURCE SYSTEM" Foreground="#819086" FontSize="10" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="SYNC STATUS" Foreground="#819086" FontSize="10" FontWeight="SemiBold" />
                        </Grid></Border>
                        <ListView x:Name="ProfileList" Grid.Row="1" ContainerContentChanging="ListView_ContainerContentChanging" SelectionMode="None" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate><DataTemplate><Border Padding="14,12" BorderBrush="#29322C" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="1.1*,1.1*,2*,1.3*,1.1*"><TextBlock Text="{Binding CustomerRef}" Foreground="{StaticResource AccentBrush}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding FieldName}" Foreground="#D0D8D1" FontSize="11" TextWrapping="Wrap" /><TextBlock Grid.Column="2" Text="{Binding FieldValue}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" TextWrapping="Wrap" /><TextBlock Grid.Column="3" Text="{Binding SystemName}" Foreground="#AAB5AC" FontSize="11" TextWrapping="Wrap" /><TextBlock Grid.Column="4" Text="{Binding SyncStatus}" Foreground="#D9B875" FontSize="10" /></Grid></Border></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="DocumentsView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1.55*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#29322C" BorderThickness="1,1,0,1">
                        <Grid RowDefinitions="Auto,*"><Border Padding="14,11" BorderBrush="#303B33" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="LOCAL SOURCES" Foreground="#819086" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" /><TextBlock x:Name="DocumentListCount" Grid.Column="1" Text="0 documents" Foreground="#819086" FontSize="11" HorizontalAlignment="Right" /></Grid></Border><ListView x:Name="DocumentList" Grid.Row="1" ContainerContentChanging="ListView_ContainerContentChanging" SelectionChanged="DocumentList_SelectionChanged" SelectionMode="Single" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Border Padding="12,12" BorderBrush="#29322C" BorderThickness="0,0,0,1"><StackPanel Spacing="7"><TextBlock Text="SOURCE DOCUMENT" Foreground="#819086" FontSize="9" FontWeight="SemiBold" /><TextBlock Text="{Binding Title}" Foreground="#E3EAE3" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding DocumentRef}" Foreground="{StaticResource AccentBrush}" FontSize="10" /></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid>
                    </Border>
                    <ScrollViewer Grid.Column="1" Background="#1B211D" BorderBrush="#29322C" BorderThickness="1" Padding="22,20"><StackPanel Spacing="13"><TextBlock x:Name="DocumentFilenameText" Text="SOURCE DOCUMENT" Foreground="#819086" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" /><TextBlock x:Name="DocumentTitleText" Text="Select a document" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Georgia" FontSize="23" TextWrapping="Wrap" /><TextBlock Text="LINKED REFERENCES" Foreground="#819086" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="DocumentRefsText" Foreground="{StaticResource AccentBrush}" FontSize="11" TextWrapping="Wrap" /><Border Background="#141916" BorderBrush="#303B33" BorderThickness="1" Padding="14"><TextBlock x:Name="DocumentContentText" Text="Choose a source document to read its contents." Foreground="#C4CEC5" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" /></Border></StackPanel></ScrollViewer>
                </Grid>
            </Grid>

            <Border x:Name="ErrorBanner" Grid.Row="4" Visibility="Collapsed" Background="#33221F" BorderBrush="#68453D" BorderThickness="1" Padding="10,7" Margin="0,10,0,0">
                <TextBlock x:Name="ErrorText" Foreground="#F0B6A9" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <Grid Grid.Row="5" Margin="0,12,0,0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Inqolobane Operations" Foreground="#738077" FontSize="10" /><TextBlock Grid.Column="1" Text="Read-only workspace  ·  Synthetic records" Foreground="#738077" FontSize="10" />
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>